{
  "name": "flashing-page-title-notification",
  "version": "3.0.0",
  "description": "A javascript plugin which allows easy use of creating a flashing page title for notification purposes.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "build-demo": "./bin/buildDemo.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtiscde/Flashing-Page-Title-Notification.git"
  },
  "author": "Curtis Timson",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/curtiscde/Flashing-Page-Title-Notification/issues"
  },
  "homepage": "https://github.com/curtiscde/Flashing-Page-Title-Notification#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
