{
  "name": "flashing-page-title",
  "version": "3.1.0",
  "description": "Flash the browser tab's page title to draw the user's attention back, e.g. for new messages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check-package": "publint && attw --pack . --profile esm-only",
    "build:site": "npm run build && npm run build -w site",
    "dev:site": "npm run build && npm run dev -w site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtiscde/flashing-page-title.git"
  },
  "author": "Curtis Timson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/curtiscde/flashing-page-title/issues"
  },
  "homepage": "https://flashing-page-title.curtiscode.dev",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "page title",
    "document title",
    "flashing",
    "blinking",
    "tab",
    "notification",
    "alert",
    "browser"
  ],
  "workspaces": [
    "site"
  ]
}
